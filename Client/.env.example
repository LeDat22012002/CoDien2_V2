# Sao chép thành .env.local rồi chỉnh theo máy.

# Đường dẫn gốc của API. Dev dùng "/api" để đi qua proxy của Vite (cùng origin, cookie refresh hoạt động).
VITE_API_BASE_URL=/api

# Chỉ dùng trong vite.config.ts (không lộ ra trình duyệt): địa chỉ Server khi chạy dev.
API_PROXY_TARGET=http://localhost:5000
